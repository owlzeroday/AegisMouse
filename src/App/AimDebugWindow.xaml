<Window x:Class="AegisMouse.App.AimDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aim Assist — Vision Debug" Height="560" Width="640"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="Manual" Topmost="True" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10">
            <Run Text="Vision debug — " /><Run Foreground="{StaticResource Accent}" Text="click an enemy pixel in the preview to lock its color" />
        </TextBlock>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Preview -->
            <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="0" ClipToBounds="True">
                <Grid Background="#FF08090C">
                    <Image x:Name="Preview" Stretch="Fill" Cursor="Cross" MouseLeftButtonUp="Preview_MouseLeftButtonUp" />
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                    <TextBlock x:Name="NoFrame" Text="No frame yet — move the mouse into the game window." 
                               Foreground="#FF6B7585" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Background="#CC000000"
                            CornerRadius="4" Padding="10,4" IsHitTestVisible="False">
                        <TextBlock Text="Click the frame to pick the enemy color" FontSize="10.5" Foreground="#FF9FE8B0" />
                    </Border>
                </Grid>
            </Border>

            <!-- Controls -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="COLOR" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Hue range (0-179)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                        <Slider Minimum="0" Maximum="179" Value="{Binding AimHueMin}" />
                        <Slider Minimum="0" Maximum="179" Value="{Binding AimHueMax}" Margin="0,4,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sat ≥" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding AimSatMin}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Val ≥" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding AimValMin}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Min size" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="3" Maximum="120" Value="{Binding AimMinSize}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AimMinSize, StringFormat={}{0:0}px}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border x:Name="PickedSwatch" Width="16" Height="16" CornerRadius="3" Background="#FF555555"
                                    BorderBrush="#FF2A303A" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="PickedInfo" Text="not picked yet" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ASSIST" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FOV radius" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="20" Maximum="500" Value="{Binding AimFovRadius}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AimFovRadius, StringFormat={}{0:0}px}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pull %" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="10" Maximum="95" Value="{Binding AimPull}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AimPull, StringFormat={}{0:P0}}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max turn" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="40" Value="{Binding AimMaxTurn}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AimMaxTurn, StringFormat={}{0:0}px/f}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Aim point" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AimOffsetPct}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AimOffsetPct, StringFormat={}{0}% down}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="STATS" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="Stats" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="19"
                                   Text="capture: -- ms · detect: -- ms&#x0a;targets: -- · selected: -- · dist: --&#x0a;armed: -- · capture: ---×---" />
                        <Button Content="Save frame + settings (F9)" Margin="0,10,0,0" Click="SaveFrame_Click" />
                        <TextBlock x:Name="SaveNote" FontSize="10.5" Foreground="#FF6B7585" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="F9 saves the current frame + HSV settings to %ProgramData%\AegisMouse\aimdebug\ — send me the PNG." />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="0,12,0,0"
                   Text="Only capture + detection run while this window is open or the aim trigger is held. Green boxes = detected targets, circle = FOV radius, cross = aim point." />
    </Grid>
</Window>
