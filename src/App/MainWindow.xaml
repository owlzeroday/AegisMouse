<Window x:Class="AegisMouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AegisMouse.App.ViewModels"
        mc:Ignorable="d"
        Title="AegisMouse" Height="740" Width="1120" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             HEADER — FIXED: logo + title now in one StackPanel (no overlap)
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo + title grouped together -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
                            <GradientStop Color="{StaticResource AccentPressedColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35" Color="{StaticResource AccentColor}" />
                    </Border.Effect>
                    <TextBlock Text="AM" Foreground="#FF0B0E13" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AegisMouse" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="  universal mouse macros — any brand" Foreground="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,2,0,0" />
            </StackPanel>

            <!-- Right side: macros toggle -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MACROS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border CornerRadius="6" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MasterEnabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <CheckBox IsChecked="{Binding MasterEnabled}" Content="Enabled" Foreground="{StaticResource Text}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             BODY
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: profiles -->
            <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="PROFILES" Foreground="{StaticResource Muted}" FontSize="11"
                               FontWeight="SemiBold" Margin="2,0,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Muted}"
                                               FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Rename:" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,14,0,4" />
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ New" Margin="0,0,4,0" Command="{Binding AddProfileCommand}" />
                        <Button Grid.Column="1" Content="Delete" Margin="4,0,0,0" Command="{Binding DeleteProfileCommand}" />
                    </Grid>
                    <TextBox Grid.Row="4" Margin="0,10,0,0" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Rename the selected profile" />
                </Grid>
            </Border>

            <!-- Main tabs -->
            <TabControl Grid.Column="1">
                <TabItem Header="Assignments">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="BindingsGrid" ItemsSource="{Binding Bindings}"
                                  SelectedItem="{Binding SelectedBinding}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Button" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static vm:BindingItem.AllButtons}"
                                                      SelectedItem="{Binding Trigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Function" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Mode" DisplayMemberPath="Label"
                                                      SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fire rate (RPM)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding FireRateRpm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Burst" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding BurstCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Armed while" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ArmOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Key" DisplayMemberPath="Value"
                                                      SelectedValue="{Binding ArmButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Remap key" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Keys, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Vk" DisplayMemberPath="Name"
                                                      SelectedValue="{Binding RemapVk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+ Add binding" Command="{Binding AddBindingCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Remove" Margin="8,0,0,0"
                                    Command="{Binding RemoveBindingCommand}"
                                    CommandParameter="{Binding ElementName=BindingsGrid, Path=SelectedItem}" />
                            <TextBlock Text="Recoil comp arms only while the armed button is held. Key remap swallows the original button." 
                                       Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Macros">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Sequence played on button-down while the binding function is 'Hold macro'. Delay runs before each action; Hold is the down-time for clicks/taps. Repeat > 1 replays the action with an interval between reps." />
                        <DataGrid x:Name="MacrosGrid" Grid.Row="1" ItemsSource="{Binding MacroActions}" CanUserAddRows="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Action" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static vm:MacroActionItem.AllKinds}"
                                                      SelectedItem="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Button" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static vm:BindingItem.AllButtons}"
                                                      SelectedItem="{Binding Button, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Key" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Keys, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Vk" DisplayMemberPath="Name"
                                                      SelectedValue="{Binding Vk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dx" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Dx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dy" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Dy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Delay ms" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Hold ms" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding HoldMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Repeat" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Repeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Interval ms" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding RepeatIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+ Add action" Command="{Binding AddActionCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Remove" Margin="8,0,0,0"
                                    Command="{Binding RemoveActionCommand}"
                                    CommandParameter="{Binding ElementName=MacrosGrid, Path=SelectedItem}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Recoil">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="PresetCombo" Width="170" ItemsSource="{Binding RecoilPresets}"
                                      SelectedIndex="0" />
                            <Button Content="Apply" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                                    Command="{Binding ApplyPresetCommand}"
                                    CommandParameter="{Binding ElementName=PresetCombo, Path=SelectedItem}" />
                            <TextBlock Text="Strength:" VerticalAlignment="Center" Margin="18,0,8,0" />
                            <Slider Width="140" Minimum="0.25" Maximum="2.0" TickFrequency="0.05"
                                    Value="{Binding RecoilStrength}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecoilStrength, StringFormat={}{0:F2}x}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button x:Name="CalibrateBtn" Content="Calibrate" Margin="24,0,0,0" Command="{Binding ToggleCalibrateCommand}" />
                            <TextBlock Text="Dpi:" VerticalAlignment="Center" Margin="18,0,8,0" />
                            <TextBox Width="80" Text="{Binding Dpi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <DataGrid x:Name="RecoilGrid" Grid.Row="1" ItemsSource="{Binding RecoilRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Shot" Binding="{Binding Shot}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Dx" Binding="{Binding Dx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="Dy (down px)" Binding="{Binding Dy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="Delay ms" Binding="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+ Add row" Command="{Binding AddRowCommand}" Style="{StaticResource AccentButton}" />
                            <Button Content="Remove" Margin="8,0,0,0"
                                    Command="{Binding RemoveRowCommand}"
                                    CommandParameter="{Binding ElementName=RecoilGrid, Path=SelectedItem}" />
                            <TextBlock Text="Rows apply in order per shot while the trigger is held; steps push the crosshair down Dy px (strength-scaled) to counter game recoil."
                                       Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Humanization" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding HumanizeEnabled}" Content="Enable timing variation (anti-detection jitter)" Margin="0,0,0,12" />
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay jitter (±ms)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding DelayJitterMs}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DelayJitterMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hold jitter (±ms)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding HoldJitterMs}" />
                                    <TextBlock Grid.Column="2" Text="{Binding HoldJitterMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Move jitter (px/axis)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="6" Value="{Binding MoveJitterCounts}" />
                                    <TextBlock Grid.Column="2" Text="{Binding MoveJitterCounts, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Step skip chance (%)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding StepSkipPercent}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StepSkipPercent, StringFormat={}{0} %}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows" Margin="0,0,0,10" />
                                <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Minimize to system tray instead of taskbar" Margin="0,0,0,14" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="AegisMouse 1.0 — works with any mouse: input is synthesized at the OS level (SendInput + low-level hooks), so no vendor driver is required. Timings are executed on a high-resolution timer (1 ms)." />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Legal note: automated input may violate the terms of service of some games. Use responsibly — only on games and servers that allow macros, never for cheating in competitive play." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS BAR
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" CornerRadius="8" Padding="14,8" Margin="0,14,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF14181F" Offset="0" />
                    <GradientStop Color="#FF0D1016" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" Color="#FF000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="11.5"
                           FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CalibBadge" Text="CALIBRATING" Foreground="White" Background="{StaticResource Danger}"
                           FontSize="10" FontWeight="Bold" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
